  "entries": [
    {
      "id": "later-scrub-table",
      "kind": "invitation",
      "title": "A brush for scrubbing the table",
      "summary": "Davies adds table scrubbing to the familiar work of wiping: a bowl, soap, brush, and sponge kept together, with adult help and supervision.",
      "cue": "Your child is interested in scrubbing as well as wiping.",
      "detail": [
        "Her activity list places the materials on a tray. Your child can explore the brush movement or return to the sponge without carrying out every part of the job.",
        "Show slowly, limit what you put out, and keep cleanup materials ready. A scrubbed patch is a useful contribution even when you finish the rest."
      ],
      "references": [
        {
