---
import { formatCopy } from '../lib/site-copy';

const { garden, copy } = Astro.props;
const number = new Intl.NumberFormat('en-US');
const touchedLabel = (day) =>
  formatCopy(
    day.touched === 1 ? copy.touchedSingularTemplate : copy.touchedPluralTemplate,
    { count: number.format(day.touched) }
  );
const cellLabel = (day) =>
  formatCopy(copy.cellLabelTemplate, {
    date: day.label,
    touched: touchedLabel(day),
    added: number.format(day.added),
    edited: number.format(day.edited),
    removed: number.format(day.removed)
  });
const rangeDescription = formatCopy(copy.rangeDescriptionTemplate, {
  startDate: garden.startDate,
  endDate: garden.endDate
});
---

<section class="word-garden" aria-labelledby="word-garden-title">
  <div class="word-garden-heading">
    <h2 id="word-garden-title">{copy.title}</h2>
    <p id="word-garden-description" class="word-garden-description">
      {copy.description}
    </p>
  </div>

  <div class="word-garden-stats" aria-label={copy.totalsLabel}>
    <span><strong>{number.format(garden.activeDays)}</strong> {copy.activeDaysLabel}</span>
    <span><strong>{number.format(garden.totals.added)}</strong> {copy.addedLabel}</span>
    <span><strong>{number.format(garden.totals.edited)}</strong> {copy.editedLabel}</span>
    <span><strong>{number.format(garden.totals.removed)}</strong> {copy.removedLabel}</span>
  </div>

  <p id="word-garden-range-description" class="visually-hidden">
    {rangeDescription}
  </p>

  <div
    class="word-garden-scroll"
    tabindex="0"
    aria-label={copy.calendarLabel}
    aria-describedby="word-garden-description word-garden-range-description"
  >
    <div class="word-garden-calendar">
      <div class="word-garden-weekdays" aria-hidden="true">
        {copy.weekdayLabels.map((label) => <span>{label}</span>)}
      </div>

      <div class="word-garden-weeks">
        {garden.weeks.map((week) => (
          <div class="word-garden-week">
            <span class="word-garden-month" aria-hidden="true">
              {week.monthLabel}
            </span>
            {week.days.map((day) => (
              <span
                class="word-garden-plot"
                tabindex={day.touched > 0 ? '0' : undefined}
                role={day.touched > 0 ? 'img' : undefined}
                aria-label={day.touched > 0 ? cellLabel(day) : undefined}
                aria-hidden={day.touched === 0 ? 'true' : undefined}
              >
                <span
                  class:list={[
                    'word-garden-cell',
                    `word-garden-cell-level-${day.level}`,
                    day.future && 'is-future'
                  ]}
                />
                {day.touched > 0 ? (
                  <span class="word-garden-tooltip" aria-hidden="true">
                    <strong>{touchedLabel(day)}</strong>
                    <span>{day.label}</span>
                  </span>
                ) : null}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="word-garden-legend" aria-label={copy.legendLabel}>
    <span>{copy.quietLabel}</span>
    <span class="word-garden-legend-cells" aria-hidden="true">
      {[0, 1, 2, 3, 4].map((level) => (
        <i class={`word-garden-cell word-garden-cell-level-${level}`} />
      ))}
    </span>
    <span>{copy.flourishingLabel}</span>
  </div>
</section>
