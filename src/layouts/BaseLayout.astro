---
import { getEntry } from 'astro:content';
import '../styles/global.css';

const {
  title,
  description,
  enableMath = false,
  canonicalPath,
  pageType = 'website',
  robots,
  pageClass
} = Astro.props;
const pageTitle = title ? `Vansh Kumar | ${title}` : 'Vansh Kumar';
const pathname = Astro.url.pathname;
const siteEntry = await getEntry('pages', 'site');
const brandSubtitle =
  siteEntry?.data?.brandSubtitle ?? 'Hunches, projects, and quiet experiments.';
const pageDescription = description?.trim() || brandSubtitle;
const siteUrl = 'https://vanshkumar.net';
const ogImage = `${siteUrl}/og.png`;
const canonicalUrl = new URL(canonicalPath ?? pathname, Astro.site ?? siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3HGGFGZK6Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-3HGGFGZK6Y');
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Vansh Kumar" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={pageType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/brand/vk_logo.png" />
    <link rel="apple-touch-icon" href="/brand/vk_logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {enableMath ? (
      <>
        <script is:inline>
          window.MathJax = {
            tex: {
              inlineMath: [['$', '$'], ['\\(', '\\)']],
              displayMath: [['$$', '$$'], ['\\[', '\\]']],
              processEscapes: true
            },
            options: {
              skipHtmlTags: [
                'script',
                'noscript',
                'style',
                'textarea',
                'pre',
                'code'
              ]
            },
            chtml: {
              matchFontHeight: false
            }
          };
        </script>
        <script
          async
          id="MathJax-script"
          src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"
        ></script>
      </>
    ) : null}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header-inner">
          <a class="site-name" href="/">Vansh Kumar</a>
        </div>
      </header>

      <div class:list={['page', pageClass]}>
        <main class="content" id="main-content" tabindex="-1">
          <slot />
        </main>
      </div>

      <footer class="site-footer">
        <div class="site-footer-inner">
          <nav class="site-footer-links" aria-label="Footer">
            <a href="/posts">Posts</a>
            <a href="/notes">Notes</a>
            <a href="/now">Now</a>
            <a href="/shelf">Shelf</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="https://x.com/lunchwithav" rel="me noopener noreferrer" target="_blank" class="external-link">Twitter</a>
            <a href="https://vanshkumar.substack.com/" rel="noopener noreferrer" target="_blank" class="external-link">Substack</a>
            <a href="/rss.xml">RSS</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
