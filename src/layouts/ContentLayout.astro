---
import BaseLayout from './BaseLayout.astro';
import { formatCopy, getSiteCopy } from '../lib/site-copy';

const {
  title,
  description,
  date,
  kind,
  kindHref,
  backlinks = [],
  lastUpdated,
  showDateRange = false,
  showHeaderDivider = true
} = Astro.props;
const formatHeaderDate = (value) =>
  new Intl.DateTimeFormat('en-US', {
    dateStyle: 'medium',
    timeZone: 'UTC'
  }).format(value);
const startDate = date ?? (showDateRange ? lastUpdated : null);
const endDate = showDateRange ? lastUpdated ?? startDate : null;
const formattedDate = startDate
  ? showDateRange && endDate
    ? `${formatHeaderDate(startDate)} – ${formatHeaderDate(endDate)}`
    : formatHeaderDate(startDate)
  : null;
const meta = [formattedDate, kind].filter(Boolean).join(' | ');
const formattedLastUpdated = lastUpdated
  ? new Intl.DateTimeFormat('en-CA', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      timeZone: 'UTC'
    }).format(lastUpdated)
  : null;
const siteCopy = await getSiteCopy();
---

<BaseLayout
  title={title}
  description={description}
  enableMath
  pageType={kind ? 'article' : 'website'}
>
  <article class="article">
    <header class:list={['article-header', !showHeaderDivider && 'article-header-no-divider']}>
      {kind && kindHref ? <a class="article-kind" href={kindHref}>{kind}</a> : null}
      <h1>{title}</h1>
      {description ? <p class="lede">{description}</p> : null}
      {meta ? <p class="meta">{meta}</p> : null}
    </header>
    <div class="prose">
      <slot />
    </div>
    <slot name="after-content" />

    {backlinks.length ? (
      <section class="section">
        <h2>{siteCopy.content.backlinksTitle}</h2>
        <ul class="list">
          {backlinks.map((link) => (
            <li>
              <a href={link.url}>{link.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    {!showDateRange && formattedLastUpdated ? (
      <div class="content-updated">
        {formatCopy(siteCopy.content.lastUpdatedTemplate, { date: formattedLastUpdated })}
      </div>
    ) : null}
  </article>
</BaseLayout>
