---
import { getSiteCopy } from '../lib/site-copy';

const { title, titleKey, target, messageKey = 'pageMoved' } = Astro.props;
const siteCopy = await getSiteCopy();
const resolvedTitle = title ?? siteCopy.redirects.titles[titleKey];
const message = siteCopy.redirects.messages[messageKey];
if (!resolvedTitle || !message) {
  throw new Error(`Missing redirect copy for ${titleKey ?? title} / ${messageKey}`);
}
const canonicalUrl = new URL(target, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <title>{resolvedTitle}</title>
    <style>
      body { margin: 0; padding: 3rem 1.25rem; background: #fffdfa; color: #28231e; font-family: Georgia, serif; }
      p { max-width: 42rem; margin: 0 auto; }
      a { color: #315c39; text-underline-offset: .17em; }
    </style>
  </head>
  <body>
    <p>
      {message} {siteCopy.redirects.destinationConnector} <a href={target}>{target}</a>.
    </p>
  </body>
</html>
