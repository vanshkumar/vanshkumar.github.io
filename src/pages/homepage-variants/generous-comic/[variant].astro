---
export function getStaticPaths() {
  return [
    { slug: 'comic-first', title: 'Comic First' },
    { slug: 'hello-first', title: 'Hello First' },
    { slug: 'masthead-strip', title: 'Masthead Strip' },
    { slug: 'comic-interlude', title: 'Comic Interlude' },
    { slug: 'framed-frontispiece', title: 'Framed Frontispiece' },
    { slug: 'quiet-bookmark', title: 'Quiet Bookmark' }
  ].map((concept) => ({
    params: { variant: concept.slug },
    props: { concept }
  }));
}

const { concept } = Astro.props;
const variant = concept.slug;

const selected = [
  {
    href: '/terrain/partition-summer',
    title: 'Partition Summer',
    description: 'A comic memoir of the 1947 Partition of India, as seen through my grandfather’s childhood memories.'
  },
  {
    href: '/terrain/how-do-we-learn-dec-2025-aliveline',
    title: 'Doing computational neuroscience in a month, from scratch',
    description: 'What happened when I gave myself a month to have and publish an original insight about the brain.'
  },
  {
    href: '/terrain/how-can-i-have-a-better-rest-ethic',
    title: 'How can I have a better rest ethic?',
    description: 'Learning to treat focus as abundant rather than precious, fragile, and easily lost.'
  }
];

const recent = [
  { href: '/terrain/what-might-a-more-physical-tactile-computing-experience-look-like-for-kids', title: 'What might a more physical & tactile computing experience look like for kids?' },
  { href: '/terrain/a-mind-cannot-be-defined-independently-of-its-social-environment', title: 'A mind cannot be defined independently of its social environment' },
  { href: '/terrain/what-is-the-future-of-the-university', title: 'What is the future of the university?' }
];
---

<!doctype html>
<html lang="en" data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Vansh Kumar — {concept.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Libre+Caslon+Text:ital@0;1&display=swap" rel="stylesheet" />
    <style is:global>
      * { box-sizing: border-box; }
      #dev-toolbar-root { display: none !important; }
      body { margin: 0; }
      a { text-underline-offset: .17em; }
      .comic-first { min-height: 100vh; background: #fffdfa; color: #28231e; font-family: 'Libre Caslon Text', Georgia, serif; }
      .cf-shell { width: min(920px, calc(100% - 44px)); margin: 0 auto; padding: 45px 0 92px; }
      .cf-name { display: inline-block; margin-bottom: 63px; color: inherit; font-size: 1.03rem; text-decoration: none; }
      .cf-frontispiece { margin: 0 0 77px; }
      .cf-frontispiece img { display: block; width: 100%; height: auto; border: 1px solid #c8c2b8; filter: sepia(.06); }
      .cf-frontispiece figcaption { margin-top: 9px; color: #8c857c; font-family: Inter, sans-serif; font-size: .6rem; text-align: right; }
      .cf-copy { width: min(710px, 100%); margin: 0 auto; }
      .cf-intro { margin: 0; font-size: clamp(1.48rem, 3vw, 2.08rem); line-height: 1.42; }
      .cf-intro + .cf-intro { margin-top: 18px; }
      .comic-first a { color: #315c39; text-decoration-color: #9fac98; text-decoration-thickness: 1px; }
      .cf-directory { margin: 35px 0 83px; padding: 0; list-style: none; color: #6f685f; font-size: .91rem; line-height: 1.75; }
      .cf-directory li::before { margin-right: 9px; color: #a69f94; content: '—'; }
      .cf-section { margin-top: 67px; }
      .cf-section h2 { margin: 0 0 25px; color: #6b655d; font-family: Inter, sans-serif; font-size: .64rem; font-weight: 500; letter-spacing: .15em; text-transform: uppercase; }
      .cf-feature + .cf-feature { margin-top: 26px; }
      .cf-feature a { color: #28231e; font-size: 1.27rem; line-height: 1.35; }
      .cf-feature p { margin: 6px 0 0; color: #7e766d; font-size: .85rem; font-style: italic; line-height: 1.55; }
      .cf-recent { margin: 0; padding-left: 1.2rem; }
      .cf-recent li + li { margin-top: 9px; }
      .cf-recent li::marker { color: #a3a097; }
      .cf-recent a { color: #28231e; line-height: 1.45; }
      .cf-note { margin-top: 72px; color: #999086; font-family: Inter, sans-serif; font-size: .64rem; }

      /* Shared 05 language for the five placement studies. */
      .gc-home { min-height: 100vh; background: #fffdfa; color: #28231e; font-family: 'Libre Caslon Text', Georgia, serif; }
      .gc-home a { color: #315c39; text-decoration-color: #9fac98; text-decoration-thickness: 1px; }
      .gc-shell { width: min(710px, calc(100% - 44px)); margin: 0 auto; padding: 46px 0 92px; }
      .gc-name { display: inline-block; margin-bottom: 78px; color: #28231e !important; font-size: 1.03rem; text-decoration: none; }
      .gc-intro { margin: 0; font-size: clamp(1.48rem, 3vw, 2.08rem); line-height: 1.42; }
      .gc-intro + .gc-intro { margin-top: 18px; }
      .gc-directory { margin: 35px 0 81px; padding: 0; list-style: none; color: #6f685f; font-size: .91rem; line-height: 1.75; }
      .gc-directory li::before { margin-right: 9px; color: #a69f94; content: '—'; }
      .gc-section { margin-top: 65px; }
      .gc-section h2 { margin: 0 0 25px; color: #6b655d; font-family: Inter, sans-serif; font-size: .64rem; font-weight: 500; letter-spacing: .15em; text-transform: uppercase; }
      .gc-feature + .gc-feature { margin-top: 26px; }
      .gc-feature a { color: #28231e; font-size: 1.27rem; line-height: 1.35; }
