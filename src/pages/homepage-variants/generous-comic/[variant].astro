      .gc-recent { margin: 0; padding-left: 1.2rem; }
      .gc-recent li + li { margin-top: 9px; }
      .gc-recent li::marker { color: #a3a097; }
      .gc-recent a { color: #28231e; line-height: 1.45; }
      .gc-note { margin-top: 70px; color: #999086; font-family: Inter, sans-serif; font-size: .64rem; }
      .gc-comic img { display: block; width: 100%; height: auto; }
      .gc-comic figcaption { margin-top: 9px; color: #8c857c; font-family: Inter, sans-serif; font-size: .6rem; }

      /* 02 — Hello First */
      .hf-comic { width: min(920px, calc(100vw - 44px)); margin: 72px calc(50% - min(460px, calc(50vw - 22px))) 79px; }
      .hf-comic img { border: 1px solid #c8c2b8; }
      .hf-comic figcaption { text-align: right; }
      .hf-directory { margin-bottom: 0; }

      /* 03 — Masthead Strip */
      .masthead-strip { background: #fbfaf6; }
      .mh-front { margin: 0; padding: 18px 18px 17px; border-bottom: 1px solid #d5d0c6; background: #fff; }
      .mh-front img { width: min(100%, 980px); margin: 0 auto; border: 1px solid #bfbab1; }
      .mh-front figcaption { width: min(100%, 980px); margin: 7px auto 0; text-align: right; }
      .mh-shell { padding-top: 50px; }
      .mh-name { margin-bottom: 68px; }

      /* 04 — Comic Interlude */
      .ci-name { margin-bottom: 76px; }
      .ci-comic { width: min(860px, calc(100vw - 38px)); margin: 45px calc(50% - min(430px, calc(50vw - 19px))) 45px; }
      .ci-comic img { border: 1px solid #c8c2b8; }
      .ci-comic figcaption { text-align: right; }

      /* 05 — Framed Frontispiece */
      .framed-frontispiece { background: #f7f2e9; }
      .ff-shell { width: min(920px, calc(100% - 44px)); }
      .ff-name { margin-bottom: 60px; }
      .ff-label { margin-bottom: 12px; color: #837c72; font-family: Inter, sans-serif; font-size: .61rem; letter-spacing: .15em; text-transform: uppercase; }
      .ff-comic { margin: 0 0 76px; padding: 27px; border: 1px solid #c9c1b4; background: #eae3d8; box-shadow: 0 18px 45px rgba(72, 61, 46, .08); }
      .ff-comic img { border: 1px solid #aaa49b; }
      .ff-comic figcaption { text-align: center; }
      .ff-copy { width: min(710px, 100%); margin: 0 auto; }

      /* 06 — Quiet Bookmark */
      .qb-name { margin-bottom: 65px; }
      .qb-comic { margin: 0 0 69px; }
      .qb-comic img { border: 1px solid #d2ccc2; opacity: .9; }
      .qb-comic figcaption { text-align: left; }
      .qb-rule { width: 35px; height: 1px; margin: 0 0 38px; background: #9d978e; }
      @media (max-width: 680px) {
        .cf-shell { width: min(100% - 30px, 560px); padding-top: 27px; }
        .cf-name { margin-bottom: 42px; }
        .cf-frontispiece { margin-bottom: 56px; }
        .cf-intro { font-size: 1.43rem; }
        .gc-shell, .ff-shell { width: min(100% - 30px, 560px); padding-top: 27px; }
        .gc-name, .mh-name, .ci-name, .ff-name, .qb-name { margin-bottom: 49px; }
        .gc-intro { font-size: 1.43rem; }
        .hf-comic { width: calc(100vw - 20px); margin: 53px calc(50% - 50vw + 10px) 58px; }
        .mh-front { padding: 9px 9px 10px; }
        .mh-shell { padding-top: 35px; }
        .ci-comic { width: calc(100vw - 20px); margin: 38px calc(50% - 50vw + 10px); }
        .ff-comic { margin-bottom: 57px; padding: 12px; }
        .qb-comic { margin-bottom: 53px; }
      }
    </style>
