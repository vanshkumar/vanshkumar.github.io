---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WordGarden from '../components/WordGarden.astro';
import { titleFromSlug } from '../lib/content';
import {
  canonicalWritingPath,
  partitionWriting
} from '../lib/writing.mjs';
import { getWordActivity } from '../lib/word-activity.mjs';

const homeEntry = await getEntry('pages', 'home');
if (!homeEntry?.data.home) {
  throw new Error('Missing homepage copy in vault/pages/home.md');
}
if (!homeEntry.data.wordGarden) {
  throw new Error('Missing Word Garden copy in vault/pages/home.md');
}
const homeMarker = '<!-- home-comic -->';
const renderedHome = homeEntry.rendered?.html;
if (typeof renderedHome !== 'string') {
  throw new Error('Missing rendered content for pages/home');
}
const homeSections = renderedHome.split(homeMarker);
if (homeSections.length !== 2) {
  throw new Error('pages/home must contain exactly one <!-- home-comic --> placement marker');
}
const [beforeComic, afterComic] = homeSections;
const home = homeEntry.data.home;
const { posts } = partitionWriting(await getCollection('terrain'));
const titleFor = (entry) => entry.data.title ?? titleFromSlug(entry.slug);
const recentPosts = posts.slice(0, 3);
const wordGarden = getWordActivity();
---

<BaseLayout description={homeEntry.data.description} pageClass="home-page">
  <div class="home-copy">
    <div class="home-static home-static-intro" set:html={beforeComic} />

    <figure class="home-comic">
      <img
        src={home.comic.src}
        alt={home.comic.alt}
        width={home.comic.width}
        height={home.comic.height}
      />
    </figure>

    <div class="home-static home-static-directory" set:html={afterComic} />

    <section class="home-section" aria-labelledby="recent-title">
      <div class="section-heading">
        <h2 id="recent-title">{home.recent.title}</h2>
      </div>
      <ol class="home-recent">
        {recentPosts.map((entry) => (
          <li class="home-recent-item">
            <h3><a href={canonicalWritingPath(entry)}>{titleFor(entry)}</a></h3>
            {entry.data.description ? <p>{entry.data.description}</p> : null}
          </li>
        ))}
      </ol>
    </section>

    <WordGarden garden={wordGarden} copy={homeEntry.data.wordGarden} />
  </div>
</BaseLayout>
