---
import { getCollection } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { titleFromSlug } from '../../lib/content';
import { getBacklinksForEntry } from '../../lib/wiki';
import { getSiteCopy } from '../../lib/site-copy';

export async function getStaticPaths() {
  const entries = await getCollection('poems');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const backlinks = await getBacklinksForEntry('poems', entry.slug);
const title = entry.data.title ?? titleFromSlug(entry.slug);
const siteCopy = await getSiteCopy();
---

<ContentLayout
  title={title}
  description={entry.data.description}
  date={entry.data.date}
  lastUpdated={entry.data.lastmod}
  backlinks={backlinks}
  kind={siteCopy.writing.poemLabel}
  kindHref="/poems"
  proseClass="poem-body"
>
  <Content />
</ContentLayout>
