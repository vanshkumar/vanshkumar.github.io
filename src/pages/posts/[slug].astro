---
import { getCollection } from 'astro:content';
import WritingEntry from '../../components/WritingEntry.astro';
import RedirectLayout from '../../layouts/RedirectLayout.astro';
import { titleFromSlug } from '../../lib/content';
import { canonicalWritingPath, classifyWritingEntry } from '../../lib/writing.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('terrain');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const title = entry.data.title ?? titleFromSlug(entry.slug);
const canonical = classifyWritingEntry(entry) === 'post';
---

{canonical
  ? <WritingEntry entry={entry} />
  : <RedirectLayout title={title} target={canonicalWritingPath(entry)} messageKey="writingNowNote" />}
