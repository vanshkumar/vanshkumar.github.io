---
import { getCollection, getEntry } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { titleFromSlug } from '../lib/content';
import { hasShelfReview } from '../lib/shelf.mjs';
import { formatCopy } from '../lib/site-copy';
import { amazonBookUrl, formatReadingDate, getReadingLog } from '../lib/reading-log.mjs';

const pageEntry = await getEntry('pages', 'shelf');
if (!pageEntry?.data.shelf) {
  throw new Error('Missing Shelf copy in vault/pages/shelf.md');
}
const currentMarker = '<!-- shelf-currently-reading -->';
const recommendationsMarker = '<!-- shelf-recommendations -->';
const renderedShelf = pageEntry.rendered?.html;
if (typeof renderedShelf !== 'string') {
  throw new Error('Missing rendered content for pages/shelf');
}
const currentSections = renderedShelf.split(currentMarker);
if (currentSections.length !== 2) {
  throw new Error('pages/shelf must contain exactly one <!-- shelf-currently-reading --> placement marker');
}
const [beforeCurrent, afterCurrentMarker] = currentSections;
const recommendationSections = afterCurrentMarker.split(recommendationsMarker);
if (recommendationSections.length !== 2) {
  throw new Error('pages/shelf must contain exactly one <!-- shelf-recommendations --> placement marker');
}
const [currentCopy, afterRecommendationsMarker] = recommendationSections;
const readingLogSections = afterRecommendationsMarker.split('<!-- shelf-reading-log -->');
if (readingLogSections.length !== 2) {
  throw new Error('pages/shelf must contain exactly one <!-- shelf-reading-log --> placement marker');
}
const [recommendationsCopy, readingLogCopy] = readingLogSections;
const title = pageEntry.data.title ?? titleFromSlug(pageEntry.slug);
const shelfCopy = pageEntry.data.shelf;
const bookTitle = (book) => book.data.title ?? titleFromSlug(book.slug);
const books = (await getCollection('shelf')).sort((a, b) => {
  const byTitle = bookTitle(a).localeCompare(bookTitle(b), 'en', { sensitivity: 'base' });
  return byTitle || a.slug.localeCompare(b.slug, 'en', { sensitivity: 'base' });
});
const currentlyReading = books.filter((book) => book.data.status === 'reading');
const recommendations = books.filter((book) => book.data.status === 'recommended');
const readingLog = getReadingLog(await getCollection('reading-log'));
const notesSlugs = new Set(books.filter(hasShelfReview).map((book) => book.slug));
const readingCopy = shelfCopy.readingLog;
---

<ContentLayout
  title={title}
  description={pageEntry.data.description}
  showHeaderDivider={false}
>
  {beforeCurrent.trim() ? <div class="shelf-page-copy" set:html={beforeCurrent} /> : null}
  <section class="shelf-section shelf-current-section">
    <div class="shelf-section-copy" set:html={currentCopy} />
    {currentlyReading.length ? (
      <div class="shelf-grid">
        {currentlyReading.map((book) => {
          const displayTitle = bookTitle(book);
          const hasReview = hasShelfReview(book);
          return (
            <div class="shelf-book">
              <span
                class:list={[
                  'shelf-cover',
                  !book.data.coverImage && 'shelf-cover-placeholder'
                ]}
              >
                {book.data.coverImage ? (
                  <img
                    src={book.data.coverImage}
                    alt={formatCopy(shelfCopy.coverAltTemplate, { title: displayTitle })}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="shelf-cover-title">{displayTitle}</span>
                )}
              </span>
              {hasReview ? (
                <a
                  class="shelf-review-link"
                  href={`/shelf/${book.slug}`}
                  aria-label={`${shelfCopy.reviewLinkLabel}: ${displayTitle}`}
                >
                  {shelfCopy.reviewLinkLabel} <span aria-hidden="true">→</span>
                </a>
              ) : null}
            </div>
          );
        })}
      </div>
    ) : null}
  </section>

  <section class="shelf-section shelf-recommendations-section">
    <div class="shelf-section-copy" set:html={recommendationsCopy} />
    {recommendations.length ? (
      <div class="shelf-grid">
        {recommendations.map((book) => {
          const displayTitle = bookTitle(book);
          const hasReview = hasShelfReview(book);
          return (
            <div class="shelf-book">
              <span
                class:list={[
                  'shelf-cover',
                  !book.data.coverImage && 'shelf-cover-placeholder'
                ]}
              >
                {book.data.coverImage ? (
                  <img
                    src={book.data.coverImage}
                    alt={formatCopy(shelfCopy.coverAltTemplate, { title: displayTitle })}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="shelf-cover-title">{displayTitle}</span>
                )}
              </span>
              {hasReview ? (
                <a
                  class="shelf-review-link"
                  href={`/shelf/${book.slug}`}
                  aria-label={`${shelfCopy.reviewLinkLabel}: ${displayTitle}`}
                >
                  {shelfCopy.reviewLinkLabel} <span aria-hidden="true">→</span>
                </a>
              ) : null}
            </div>
          );
        })}
      </div>
    ) : null}
  </section>

  <section id="reading-log" class="shelf-section shelf-reading-log">
    <div class="shelf-section-copy" set:html={readingLogCopy} />
    <ol class="reading-log-list" role="list">
      {readingLog.map(({ id, finished, book }) => (
        <li class="reading-log-entry" data-read-id={id}>
          {finished && finished.length > 4 ? (
            <time class="reading-log-date" datetime={finished}>{formatReadingDate(finished)}</time>
          ) : (
            <span class="reading-log-date">{finished ?? readingCopy.unknownDateLabel}</span>
          )}
          <div class="reading-log-book">
            <a class="reading-log-title" href={amazonBookUrl(book)} target="_blank" rel="noopener noreferrer">{book.title}</a>
            <span class="reading-log-author">
              {' '}{formatCopy(shelfCopy.bylineTemplate, { author: book.authors.join(', ') })}
              {book.shelfSlug && notesSlugs.has(book.shelfSlug) ? (
                <>{' '}<a class="reading-log-notes" href={`/shelf/${book.shelfSlug}`}>({readingCopy.notesLinkLabel})</a></>
              ) : null}
            </span>
          </div>
        </li>
      ))}
    </ol>
  </section>
</ContentLayout>
