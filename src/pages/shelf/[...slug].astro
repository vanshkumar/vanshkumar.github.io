---
import { getCollection, getEntry } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getBacklinksForEntry } from '../../lib/wiki';
import { titleFromSlug } from '../../lib/content';
import { hasShelfReview } from '../../lib/shelf.mjs';
import { formatCopy } from '../../lib/site-copy';

export async function getStaticPaths() {
  const entries = await getCollection('shelf');
  return entries
    .filter((entry) => hasShelfReview(entry))
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry }
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const backlinks = await getBacklinksForEntry('shelf', entry.slug);
const title = entry.data.title ?? titleFromSlug(entry.slug);
const lastUpdated = entry.data.lastmod ?? entry.data.date ?? null;
const shelfPage = await getEntry('pages', 'shelf');
if (!shelfPage?.data.shelf) {
  throw new Error('Missing Shelf copy in vault/pages/shelf.md');
}
const shelfMeta = formatCopy(shelfPage.data.shelf.bylineTemplate, {
  author: entry.data.author
});
---

<ContentLayout
  title={title}
  description={entry.data.description}
  date={entry.data.date}
  kind={shelfMeta}
  lastUpdated={lastUpdated}
  backlinks={backlinks}
>
  <Content />
</ContentLayout>
